{
    "name": "streamblocks-cal",
    "displayName": "CAL",
    "description": "CAL Actor Language support",
    "version": "0.0.1",
    "publisher": "streamblocks",
    "engines": {
      "vscode": "^1.80.0"
    },
    "categories": ["Programming Languages"],
    "activationEvents": ["onLanguage:cal"],
    "main": "./client/out/extension.js",
    "contributes": {
      "languages": [
        {
          "id": "cal",
          "aliases": ["CAL Actor Language", "CAL", "cal"],
          "extensions": [".cal", ".nl", ".CAL"],
          "configuration": "./language-configuration.json"
        }
      ],
      "grammars": [
        {
          "language": "cal",
          "scopeName": "source.cal",
          "path": "./syntaxes/cal.tmLanguage.json"
        }
      ],
      "configuration": {
        "type": "object",
        "title": "StreamBlocks Configuration",
        "properties": {
          "streamblocks.home": {
            "type": ["string", "null"],
            "default": null,
            "description": "Path to StreamBlocks CAL compiler",
            "scope": "window"
          }
        }
      }
    },
    "scripts": {
      "compile": "tsc -p ./client",
      "watch": "tsc -w -p ./client",
      "vscode:prepublish": "npm run compile",
      "test": "node ./client/out/test/runTest.js"
    },
    "devDependencies": {
      "@types/node": "^20.0.0",
      "@types/vscode": "^1.80.0",
      "@vscode/test-electron": "^2.3.0",
      "typescript": "^5.4.0",
      "vscode-languageclient": "^9.0.1"
    }
  }
  